{
    "tasks": {
        "run": "deno run -A ./server.ts",
        "run:clean": "deno task run -A --clear-artifacts",
        "test": "deno test -A --no-check && sg scan",
        "lint-artifacts": "deno run --allow-all scripts/render_lint_artifacts.ts && deno run --no-lock -A npm:stylelint 'static/**/*.css' '.lint-artifacts/**/*.css'"
    },
    "fmt": {
        "exclude": [
            "**/*.md",
            "**/*.json"
        ],
        "lineWidth": 120,
        "indentWidth": 4,
        "singleQuote": true,
        "proseWrap": "preserve"
    },
    "imports": {
        "@std/http": "jsr:@std/http@^1.1.0",
        "@std/cli": "jsr:@std/cli@1.0.29",
        "@std/dotenv": "jsr:@std/dotenv@0.225.6",
        "@std/streams": "jsr:@std/streams",
        "@std/html": "jsr:@std/html",
        "@std/media-types": "jsr:@std/media-types@1.1.0",
        "@std/path": "jsr:@std/path@1.1.4",
        "@std/async": "jsr:@std/async@1.3.0",
        "@std/bytes": "jsr:@std/bytes@^1.0.6",
        "@core/asyncutil": "jsr:@core/asyncutil",
        "mediaforge": "jsr:@globaltech/mediaforge@0.3.0",
        "simple-git": "npm:simple-git@3.36.0",
        "zip-js": "npm:@zip.js/zip.js@2.8.26",
        "preact": "npm:preact@10.26.5",
        "preact-render-to-string": "npm:preact-render-to-string@6.5.13",
        "@/": "./src/"
    },
    "compilerOptions": {
        "strict": true,
        "jsx": "react-jsx",
        "jsxImportSource": "preact"
    }
}
